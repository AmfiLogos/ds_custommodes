# Only source, scripts and notes go in git. Never game files, dumps, builds, saves or test output.
/*
!/.gitignore
!/README.md
!/NOTES.md
!/LICENSE
!/mp_pin.txt
!/build.sh
!/build_module.sh
!/cm_module.c
!/cm_mp.c
!/mod.json
!/builder/
!/fe/
!/fights/
!/gallery/
!/home/
!/pvp/
!/units/
# game binaries and dumps (copyright: never publish)
*.dll
*.dylib
*.exe
*.dat
*.so
*.o
*.a
dump/
dump.cs
il2cpp.h
script.json
methods.tsv
# builds, copies, test output
build/
build_*/
old/
old_versions/
out/
*.zip
*.png
*.jpg
*.log
*.out
*.orig
*.pyc
__pycache__/
*.lock
.DS_Store
backups/
saves/
*AutoSave*
